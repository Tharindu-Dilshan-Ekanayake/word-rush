# Copy to `.env` (or `.env.local`).
#
# Bloxity URLs (API, matchmaker, CDN) never go here: the platform tells the game its
# environment at runtime (see src/bloxity/env.js).

# The game's Bloxity slug. Defaults to shared/gameData.json -> bloxity.gameSlug.
# VITE_GAME_SLUG=slap-chips

# Bloxity hosting id: the <id> in <id>.host.bloxity.io (the same id on prod and
# stage). When set, the game joins through Bloxity's matchmaker
# (Legion.SDK.net.resolveEndpoint). Leave unset to connect straight to a local game
# server on :3000 during development.
# VITE_BLOXITY_HOSTING_ID=slap-chips

# Self-hosted game server only (not Bloxity hosting): its URL. Never point this at
# <id>.host.bloxity.io; that host is for HTTP only.
# VITE_SERVER_URL=https://game.example.com
